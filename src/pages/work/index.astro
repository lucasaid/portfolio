---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Main from "../../layouts/Main.astro";
import { workImage } from "../../lib/workImage";

const entries = await getCollection("work");

const featured = await Promise.all(
  entries
    .filter((e) => e.data.featured)
    .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
    .map(async (entry) => ({ entry, Content: (await render(entry)).Content, image: workImage(entry.data.image) }))
);
const archive = entries.filter((e) => !e.data.featured).sort((a, b) => b.data.year - a.data.year);
---

<Main title="Work — Chris Lucas">
  <div class="work">
    <a href="/">&lt;&lt; Back</a>
    <h1 class="page-title" style="margin-top: 24px">Work</h1>
    <p class="page-subtitle">A selection of professional and personal projects</p>

    {featured.length > 0 && (
      <>
        <div class="section-label">Featured</div>
        {featured.map(({ entry: { data: fm }, Content, image }) => (
          <article class="case-study">
            <div class="case-study-header">
              <h2 class="case-study-title">{fm.title}</h2>
              <span class="year">{fm.year}</span>
            </div>
            <div class="role">{fm.role}</div>
            <div class="tech-list">
              {fm.tech.map((t) => <span class="tech-tag">{t}</span>)}
            </div>
            <p class="description">{fm.description}</p>
            {fm.outcome && (
              <div class="meta-row"><span>Outcome:</span>{fm.outcome}</div>
            )}
            {image && (
              <div class="image-wrapper">
                <Image src={image} alt={fm.title} />
              </div>
            )}
            <div class="body"><Content /></div>
            {(fm.links?.live || fm.links?.github) && (
              <div class="links">
                {fm.links.live && <a href={fm.links.live} target="_blank" rel="noopener noreferrer">↗ live site</a>}
                {fm.links.github && <a href={fm.links.github} target="_blank" rel="noopener noreferrer">↗ github</a>}
              </div>
            )}
          </article>
        ))}
      </>
    )}

    {archive.length > 0 && (
      <>
        <div class="section-label" style="margin-top: 16px">Archive</div>
        <div class="archive-grid">
          {archive.map(({ id, data: fm }) => (
            <a class="archive-card" href={`/work/${id}`}>
              <div class="archive-year">{fm.year}</div>
              <div class="archive-title">{fm.title}</div>
              <div class="archive-tech">{fm.tech.join(" · ")}</div>
              <div class="archive-link">view case study →</div>
            </a>
          ))}
        </div>
      </>
    )}
  </div>
</Main>

<style lang="scss">
  .work {
    max-width: 860px;
    margin: 0 auto;
    padding: 40px 24px 80px;
    font-family: 'Courier New', monospace;
    color: var(--color-text);
  }

  .page-title {
    font-size: 2rem;
    color: var(--color-heading);
    margin-bottom: 4px;
  }

  .page-subtitle {
    color: var(--color-muted);
    font-size: 0.85rem;
    margin-bottom: 48px;
  }

  .section-label {
    font-size: 0.7rem;
    letter-spacing: 3px;
    color: var(--color-muted);
    text-transform: uppercase;
    margin-bottom: 24px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border);
  }

  // ── Featured case studies ─────────────────────────────────────

  .case-study {
    margin-bottom: 64px;
    padding-bottom: 64px;
    border-bottom: 1px solid var(--color-border);
    &:last-of-type {
      border-bottom: none;
    }
  }

  .case-study-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 6px;
  }

  .case-study-title {
    font-size: 1.3rem;
    color: var(--color-heading);
    margin: 0;
  }

  .year {
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  .role {
    color: var(--color-muted);
    font-size: 0.82rem;
    margin-bottom: 12px;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }

  .tech-tag {
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 2px;
  }

  .description {
    color: var(--color-text);
    font-size: 0.9rem;
    line-height: 1.7;
    margin-bottom: 12px;
  }

  .meta-row {
    font-size: 0.82rem;
    margin-bottom: 6px;
    color: var(--color-text);
    span {
      color: var(--color-muted);
      margin-right: 6px;
    }
  }

  // Markdown output isn't scoped, hence :global
  .body {
    font-size: 0.88rem;
    line-height: 1.8;
    color: var(--color-text);
    margin-top: 20px;
    :global(h2) { font-size: 1rem; color: var(--color-accent); margin: 20px 0 8px; }
    :global(h3) { font-size: 0.9rem; color: var(--color-accent); margin: 16px 0 6px; }
    :global(p) { margin-bottom: 12px; }
    :global(ul) { padding-left: 20px; margin-bottom: 12px; }
    :global(li) { margin-bottom: 4px; }
  }

  .links {
    display: flex;
    gap: 20px;
    margin-top: 16px;
    a {
      color: var(--color-accent);
      font-size: 0.82rem;
      text-decoration: none;
      &:hover { text-decoration: underline; }
    }
  }

  .image-wrapper {
    margin-top: 20px;
    border-radius: 3px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    img { display: block; width: 100%; height: auto; }
  }

  // ── Archive grid ──────────────────────────────────────────────

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;

    @media (max-width: 600px) {
      grid-template-columns: repeat(2, 1fr);
    }
    @media (max-width: 400px) {
      grid-template-columns: 1fr;
    }
  }

  .archive-card {
    display: block;
    border: 1px solid var(--color-border);
    padding: 14px;
    border-radius: 3px;
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 0.15s;
    cursor: pointer;

    &:hover {
      border-color: var(--color-accent);
      color: var(--color-text);
    }
  }

  .archive-year {
    font-size: 0.7rem;
    color: var(--color-muted);
    margin-bottom: 4px;
  }

  .archive-title {
    font-size: 0.9rem;
    font-weight: bold;
    color: var(--color-heading);
    margin-bottom: 4px;
  }

  .archive-tech {
    font-size: 0.72rem;
    color: var(--color-muted);
    margin-bottom: 10px;
  }

  .archive-link {
    font-size: 0.75rem;
    color: var(--color-accent);
  }
</style>
